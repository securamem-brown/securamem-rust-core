# Rust Build Artifacts
/target/
**/*.rs.bk

# Database
*.db
*.db-shm
*.db-wal

# Runtime Logs & Receipts (Never commit these)
.securamemrust/receipts/
.securamemrust/reports/
.securamemrust/logs/
.securamemrust/checkpoints/
.securamemrust/audit_bundle_check/
.securamemrust/worm/
.securamemrust/simulations/
.securamemrust/*.jsonl
.securamemrust/*.csv

# Secrets & Keys (CRITICAL - Block everything, allow nothing)
.securamemrust/keys/
.securamemrust/*.pem
.securamemrust/*.key
.securamemrust/*-key.json
.securamemrust/signing-keys.json

# Configs (Ignore runtime configs, keep templates if needed)
.securamemrust/config.json
.securamemrust/file-digests.json

# Runtime state and lock files
.securamemrust/.init_lock
.securamemrust/.migrated-*
.securamemrust/pro.enabled
.securamemrust/*.smemctx
.securamemrust/*-export.smemctx

# Test and benchmark artifacts
.securamemrust/benchmark-*.json
.securamemrust/test-*.json
.securamemrust/*.html

# OS Junk
.DS_Store
Thumbs.db
.vscode/

# Archive files
*.zip
*.tar.gz
*.7z
